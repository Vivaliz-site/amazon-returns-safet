[Unit]
Description=Amazon Returns SAFE-T independent deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=AMAZON_RETURNS_REPO=/home/ubuntu/amazon-returns-deploy-source
ExecStart=/home/ubuntu/amazon-returns-deploy-source/scripts/auto-deploy.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
