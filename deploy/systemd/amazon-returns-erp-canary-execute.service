[Unit]
Description=ShopVivaliz Amazon Returns ERP canary execute current safe candidate
After=network-online.target amazon-returns-olist-erp-browser.service amazon-returns-erp-canary-discovery.service
Wants=network-online.target amazon-returns-olist-erp-browser.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/home/ubuntu/amazon-returns-deploy/current
EnvironmentFile=-/home/ubuntu/amazon-returns-deploy/shared/.env
EnvironmentFile=/home/ubuntu/amazon-returns-deploy/current/deploy/erp-canary-execute.env
Environment=AMAZON_RETURNS_ENV_FILE=/home/ubuntu/amazon-returns-deploy/shared/.env
ExecCondition=/usr/bin/test -f /home/ubuntu/amazon-returns-deploy/shared/erp-canary-execute-once
ExecStart=/usr/bin/php /home/ubuntu/amazon-returns-deploy/current/scripts/amazon-returns/erp-sales-return-canary.php --mode=execute --auto
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
