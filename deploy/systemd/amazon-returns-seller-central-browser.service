[Unit]
Description=ShopVivaliz Amazon Returns Seller Central daily browser cycle
After=network-online.target amazon-returns-safet.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/amazon-returns-deploy/current
EnvironmentFile=-/home/ubuntu/amazon-returns-deploy/shared/seller-central-browser.env
Environment=AMAZON_RETURNS_RELEASE_ROOT=/home/ubuntu/amazon-returns-deploy/current
ExecStart=/home/ubuntu/amazon-returns-deploy/current/scripts/amazon-returns/run-seller-central-daily.sh
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/amazon-returns-deploy/shared/seller-central-browser

[Install]
WantedBy=multi-user.target
