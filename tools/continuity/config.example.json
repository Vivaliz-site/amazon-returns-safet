{
  "ledger_path": "/var/lib/agent-continuity/ledger.sqlite3",
  "worktree_root": "/var/lib/agent-continuity",
  "auto_dispatch": false,
  "repositories": [
    {
      "repository": "Vivaliz-site/amazon-returns-safet",
      "host": "shopvivaliz-free-a1",
      "path": "/home/ubuntu/amazon-returns-safet",
      "base_ref": "origin/main",
      "base_branch": "main",
      "github_enabled": true
    }
  ],
  "lease_seconds": 1800,
  "retry_cooldown_seconds": 1800,
  "agents": [
    {
      "name": "gemini",
      "command": [
        "gemini"
      ],
      "enabled": false
    },
    {
      "name": "rooter",
      "command": [
        "rooter"
      ],
      "enabled": false
    }
  ],
  "job_queue_root": "/var/lib/agent-continuity/jobs",
  "worker_root": "/srv/continuity/worktrees",
  "gemini_admin_policy": "/etc/agent-continuity/gemini-admin-policy.toml",
  "gemini_model": "gemini-3.1-flash-lite",
  "publisher_known_hosts": "/etc/agent-continuity/publisher-known-hosts",
  "max_auto_attempts": 3,
  "worker_timeout_seconds": 900
}
